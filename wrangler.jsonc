{
  // Worker de solo-assets: sirve el sitio estático generado en ./dist
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "genosrp-sora",
  "compatibility_date": "2026-09-05",

  // El build copia el sitio a dist/sora/, de modo que la URL pública
  // queda en https://genosrp.eienwolf.dev/sora/
  "assets": {
    "directory": "./dist"
  },

  // Ruta por path: solo /sora* llega a este Worker. El resto del hostname
  // queda libre para otros proyectos.
  "routes": [
    {
      "pattern": "genosrp.eienwolf.dev/sora*",
      "zone_name": "eienwolf.dev"
    }
  ],

  "observability": {
    "enabled": true
  }
}
