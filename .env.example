# Plantilla de variables de entorno. Copiar a .env (que está en .gitignore).
#
#   cp .env.example .env
#
# NUNCA subas .env al repositorio.

# --- Cloudflare (necesario para desplegar) ---
# Token de API: https://dash.cloudflare.com/profile/api-tokens
# Permisos mínimos:
#   Cuenta  → Workers Scripts : Edit
#   Cuenta  → Workers Routes  : Edit      (o Zona → Workers Routes : Edit)
#   Zona    → DNS             : Edit      (solo para `npm run setup:dns`)
#   Zona    → Zone            : Read
# Recursos: la cuenta correspondiente y la zona eienwolf.dev
CLOUDFLARE_API_TOKEN=
# ID de cuenta (dashboard → Workers & Pages → panel derecho).
# Opcional si el token solo da acceso a una cuenta.
CLOUDFLARE_ACCOUNT_ID=

# --- Fuentes de contenido (rutas locales, no secretos) ---
# Base del proyecto discord-hechizos, de donde la skill `hechizo` importa.
# Si se omite, se usa ~/apps/discord-hechizos/hechizos.db
HECHIZOS_DB=

# --- Destino del sitio (no son secretos; sirven a los scripts) ---
CLOUDFLARE_ZONE=eienwolf.dev
SITE_HOST=genosrp.eienwolf.dev
SITE_BASE_PATH=/sora
SITE_URL=https://genosrp.eienwolf.dev/sora/
